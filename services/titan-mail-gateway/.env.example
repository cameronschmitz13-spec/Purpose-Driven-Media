# Never commit real values. Use your deployment platform's secret store.
PORT=8787
PDM_MAIL_GATEWAY_TOKEN=replace-with-at-least-32-random-characters

TITAN_EMAIL=sales@example.com
TITAN_APP_PASSWORD=replace-with-titan-application-password
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-side-secret-key

# Optional. Leave blank when the mailbox is a PDM-wide operational inbox.
PDM_DEFAULT_ORGANIZATION_ID=
SYNC_FOLDER=INBOX
SYNC_RECENT_MESSAGES=150
SYNC_INTERVAL_SECONDS=300
LOG_LEVEL=info
