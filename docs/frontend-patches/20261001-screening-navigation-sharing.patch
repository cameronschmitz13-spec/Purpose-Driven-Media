+import {safeRoadmapUrl,type RoadmapAction} from './visibility-roadmap';
+import type {ReportScreening} from '../modules/business/components/ReportView';
+
+export function businessRoadmap(screening:ReportScreening):RoadmapAction[]{
+  const array=(value:string):Array<Record<string,unknown>>=>{try{const parsed=JSON.parse(value);return Array.isArray(parsed)?parsed:[];}catch{return [];}};
+  const evidence=array(screening.evidenceJson),recommendations=array(screening.recommendationsJson);
+  const supported=recommendations.filter(r=>evidence.some(e=>e.category===r.category&&e.status==='warning'&&(!e.assessment||e.assessment==='observed'))).filter((r,i,all)=>all.findIndex(other=>other.category===r.category)===i).slice(0,3);
+  const actions:RoadmapAction[]=supported.map((r,i)=>{
+    const records=evidence.filter(e=>e.category===r.category&&e.status==='warning'&&(!e.assessment||e.assessment==='observed'));
