+import {organizationReportSnapshot,privateJson,reportShareRpc,type SiteReport} from '../../../lib/site-reports';
+export const dynamic='force-dynamic';
+export async function GET(request:Request){
+ const token=new URL(request.url).searchParams.get('token')||'';
+ if(!/^[0-9a-f]{64}$/.test(token))return privateJson({error:'This share link is unavailable.'},404);
+ try{
+ const row=await reportShareRpc('site_read_shared_report',{p_token:token}) as SiteReport|null;
+ if(!row)return privateJson({error:'This share link has expired or stopped sharing.'},404);
+ if(row.screening_type==='business')return privateJson({type:'business',business:row.report_snapshot.business,screening:row.report_snapshot.screening});
+ return privateJson({type:'organization',screening:organizationReportSnapshot(row),viewerId:null,access:{isAdmin:false,canViewFullReport:true,reportAccess:'snapshot',roadmapPaidAt:null}});
+ }catch{return privateJson({error:'This shared report is temporarily unavailable.'},503);}
+}
