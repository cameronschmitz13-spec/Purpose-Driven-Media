diff --git a/app/api/report-share/route.ts b/app/api/report-share/route.ts
new file mode 100644
index 0000000..deb9f74
--- /dev/null
+++ b/app/api/report-share/route.ts
@@ -0,0 +1,20 @@
+import {getSiteReport,privateJson,reportActor,reportShareRpc,sameOrigin,shareTokenHash} from '../../../lib/site-reports';
+export const dynamic='force-dynamic';
+export async function POST(request:Request){
+ if(!sameOrigin(request))return privateJson({error:'Invalid origin.'},403);
+ const actor=await reportActor(request);if(!actor)return privateJson({error:'Sign in to share a saved report.'},401);
+ try{
+  const body=await request.json() as {reportId?:string};
+  const row=await getSiteReport(actor.authorization,body.reportId||'');if(!row)return privateJson({error:'Report not found.'},404);
+  const token=crypto.randomUUID().replaceAll('-','')+crypto.randomUUID().replaceAll('-','');
+  const expiresAt=await reportShareRpc('site_create_report_share',{p_report_id:row.id,p_token_hash:await shareTokenHash(token)},actor.authorization);
+  return privateJson({path:`/shared/report/${token}`,expiresAt});
+ }catch{return privateJson({error:'Could not create a share link. Please retry.'},503);}
+}
+export async function DELETE(request:Request){
+ if(!sameOrigin(request))return privateJson({error:'Invalid origin.'},403);
+ const actor=await reportActor(request);if(!actor)return privateJson({error:'Sign in to stop sharing.'},401);
+ try{const {token}=await request.json() as {token?:string};if(!token||!/^[0-9a-f]{64}$/.test(token))return privateJson({error:'Invalid link.'},400);
+ const revoked=await reportShareRpc('site_revoke_report_share',{p_token_hash:await shareTokenHash(token)},actor.authorization);return privateJson({revoked});
+ }catch{return privateJson({error:'Could not stop sharing. Please retry.'},503);}
+}
