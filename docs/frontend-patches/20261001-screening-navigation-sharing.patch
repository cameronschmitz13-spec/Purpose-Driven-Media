@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import vm from 'node:vm';
+import {readFile,writeFile,readdir} from 'node:fs/promises';
+import {createRequire} from 'node:module';
+import {transform} from 'esbuild';
+import React from 'react';
+import {renderToStaticMarkup} from 'react-dom/server';
+const require=createRequire(import.meta.url);
+const source=await readFile('modules/organization/app/page.tsx','utf8');
+const compiled=await transform(source+'\nexport {emptySignals};',{loader:'tsx',format:'cjs',jsx:'automatic'});
+let stateIndex=0,seed=[];
+const mod={exports:{}};
+vm.runInNewContext(compiled.code,{module:mod,exports:mod.exports,URL,URLSearchParams,Date,JSON,Number,Math,console,require(id){
+ if(id==='react/jsx-runtime')return require(id);
+ if(id==='react')return {...React,useState(initial){const index=stateIndex++;return React.useState(index<seed.length?seed[index]:initial);}};
+ if(id==='next/link')return ({href,children,...props})=>React.createElement('a',{href,...props},children);
+ if(id.includes('evidence-identity'))return require('../lib/evidence-identity.ts');
+ if(id.includes('pdm-fetch'))return {pdmFetch:()=>{throw new Error('Saved rendering must not fetch');}};
+ if(id.includes('save-screening-report'))return {readPendingReport:()=>null};
+ if(id.includes('supabase-browser'))return {getSupabaseBrowserClient:()=>{throw new Error('Server rendering must not access a session');}};
+ if(id.includes('ReportAssistant'))return {ReportAssistant:()=>React.createElement('section',{id:'pdm360-advisor'},'Advisor')};
+ return new Proxy({},{get:(_,key)=>()=>React.createElement('div',null,String(key))});
+}});
+const ids=['search','clarity','readiness','consistency','freshness'];
+const snapshot={id:'5213c469-eb68-4d19-ab37-6a3d8bab5ee8',organizationName:'LifePoint Fixture',organizationType:'church',submittedLocation:'Chillicothe, MO',resolvedLocation:'Chillicothe, MO',currentScore:74,potentialScore:92,createdAt:'2026-09-29T21:27:19Z',scoringSnapshot:{categoryScores:ids.map((id,i)=>({id,category:['Search findability','Website clarity','Visitor readiness','Listing consistency','Freshness & content'][i],points:[17,15,11,14,17][i],checkpoints:[{id:'recorded',label:'Recorded checkpoint',points:2,evidence:'Exact original evidence'}]}))}};
+function markup(type){
+ const links={website:'https://lifepoint-church.com/',google:'https://www.google.com/maps/search/?api=1&query=LifePoint',facebook:'',instagram:'',youtube:'',linkedin:'',tiktok:'',other:''};
+ const updates=Object.fromEntries(Object.keys(links).map(k=>[k,{recency:'week',frequency:'weekly'}]));
+ const analysis={reachable:true,pagesScanned:6,signals:mod.exports.emptySignals};
+ // Main component state, followed by normal local state for its child components.
+ seed=[Date.parse(snapshot.createdAt),'results',{...snapshot,organizationType:type},snapshot.organizationName,'',type,'Chillicothe, MO','small_town','county',links,updates,analysis,{found:true,lat:39.7948749,lon:-93.5532779,address:{city:'Chillicothe',state:'Missouri'}},null,{available:true,geographyName:'Livingston County',metrics:{population:14364}},'ready',null,null,[],null,null,'','',false,'saved',null,null,{isAdmin:true,canViewFullReport:true,reportAccess:'full',roadmapPaidAt:null},''];
+ stateIndex=0;
+ return renderToStaticMarkup(React.createElement(mod.exports.ScreeningExperience));
+}
+test('reopened screenings use the full interactive results UI and recorded scores for every organization sector',()=>{
+ for(const type of ['church','nonprofit','organization']){
+ const html=markup(type);
+ assert.match(html,/media-map-nodes/);assert.match(html,/map-channel-dock/);assert.match(html,/live-community-map__tools/);
+ assert.match(html,/Exact original evidence/);assert.match(html,/74/);assert.match(html,/Livingston County/);
+ assert.match(html,/organization\/roadmap\/5213c469-eb68-4d19-ab37-6a3d8bab5ee8/);
+ assert.doesNotMatch(html,/Full saved PDM 360|Recorded category scores/);
+ }
+});
+test('saved loader hydrates results instead of the condensed report without saving or automatic research',()=>{
+ assert.match(source,/setSavedReport\(screening\);\s*setView\("results"\)/);
+ assert.match(source,/if \(savedReport \|\| view !== "results" \|\| screeningSaveState !== "idle"\) return/);
+ assert.match(source,/if \(savedReport \|\| view !== "results" \|\| !city.trim\(\)/);
+ assert.doesNotMatch(source,/<SavedOrganizationReport/);
+});
+
+if(process.env.PDM_LAYOUT_FIXTURE){
+ const assets=await readdir('dist/client/assets');
+ const css=(await Promise.all(assets.filter(name=>name.endsWith('.css')).map(name=>readFile(`dist/client/assets/${name}`,'utf8')))).join('\n');
+ await writeFile('public/__qa-screening.html',`<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><style>${css}</style></head><body><div class="pdm-app pdm-organization-app">${markup('church')}</div></body></html>`);
+}
