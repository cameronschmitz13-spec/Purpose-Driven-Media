+import assert from 'node:assert/strict';
+import test from 'node:test';
+import vm from 'node:vm';
+import {build} from 'esbuild';
+import {readFile} from 'node:fs/promises';
+const compiled=await build({entryPoints:['lib/business-roadmap.ts'],bundle:true,write:false,platform:'node',format:'cjs'});
+const mod={exports:{}};vm.runInNewContext(compiled.outputFiles[0].text,{module:mod,exports:mod.exports,URL});
+test('separate business roadmap retains observed findings and excludes unknown/ambiguous gaps',()=>{
+ const screening={totalScore:48,evidenceJson:JSON.stringify([{category:'clarity',status:'warning',assessment:'observed',detail:'Service area absent in reviewed HTML',source:'https://fixture.example/service'},{category:'trust',status:'warning',assessment:'unknown',detail:'Unretrieved reviews',source:'javascript:alert(1)'}]),recommendationsJson:JSON.stringify([{category:'clarity',title:'State the service area',action:'List the towns served'},{category:'trust',title:'Invent reviews',action:'Invent ratings'}])};
+ const plan=mod.exports.businessRoadmap(screening);
+ assert.equal(plan.length,2);assert.equal(plan[0].title,'State the service area');assert.equal(plan[0].sources[0],'https://fixture.example/service');assert.doesNotMatch(JSON.stringify(plan),/Invent|javascript:/);assert.match(plan[1].basis,/48\/100/);
+});
+test('roadmap links target separate authorized pages rather than anchors or same-page queries',async()=>{
+ const [organization,business,orgRoute,businessRoute]=await Promise.all(['modules/organization/app/page.tsx','modules/business/components/ReportView.tsx','app/organization/roadmap/[id]/page.tsx','app/business/report/[id]/roadmap/page.tsx'].map(path=>readFile(path,'utf8')));
+ assert.match(organization,/`\/organization\/roadmap\//);assert.match(business,/\/business\/report\/\$\{encodeURIComponent\(screening.publicId\)\}\/roadmap/);assert.match(orgRoute,/SupabaseOrganizationRoadmap/);assert.match(businessRoute,/SupabaseBusinessReport reportId=\{id\} roadmap/);
+});
