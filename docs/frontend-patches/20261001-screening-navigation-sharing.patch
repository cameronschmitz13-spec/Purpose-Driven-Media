@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {readFile} from 'node:fs/promises';
+import {transform} from 'esbuild';
+import vm from 'node:vm';
+async function route(path,mocks){const source=await readFile(path,'utf8');const compiled=await transform(source,{loader:'ts',format:'cjs'});const mod={exports:{}};vm.runInNewContext(compiled.code,{module:mod,exports:mod.exports,Response,URL,crypto:globalThis.crypto,require:()=>mocks});return mod.exports;}
+const json=(data,status=200)=>Response.json(data,{status});
+test('sharing requires authenticated report access and does not disclose a token on denial',async()=>{
+ let calls=0;const mocks={sameOrigin:()=>true,reportActor:async()=>null,privateJson:json,reportShareRpc:async()=>{calls++;}};
+ const api=await route('app/api/report-share/route.ts',mocks);
+ assert.equal((await api.POST(new Request('https://fixture.example/api/report-share',{method:'POST',body:'{}'}))).status,401);
+ mocks.reportActor=async()=>({authorization:'Bearer fixture'});mocks.getSiteReport=async()=>null;
+ assert.equal((await api.POST(new Request('https://fixture.example/api/report-share',{method:'POST',body:'{"reportId":"other"}'}))).status,404);assert.equal(calls,0);
+});
+test('shared reader denies malformed, nonexistent or expired capability without falling back to intake',async()=>{
+ let calls=0;const api=await route('app/api/shared-report/route.ts',{privateJson:json,reportShareRpc:async()=>{calls++;return null;}});
+ assert.equal((await api.GET(new Request('https://fixture.example/api/shared-report?token=invalid'))).status,404);assert.equal(calls,0);
+ assert.equal((await api.GET(new Request(`https://fixture.example/api/shared-report?token=${'a'.repeat(64)}`))).status,404);assert.equal(calls,1);
+});
