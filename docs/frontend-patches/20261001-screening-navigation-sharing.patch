+"use client";
+import {useEffect,useState} from 'react';
+import {pdmFetch} from '../lib/pdm-fetch';
+import {getSupabaseBrowserClient} from '../lib/supabase-browser';
+import {VisibilityRoadmap} from '../modules/organization/components/VisibilityRoadmap';
+import type {SavedOrganizationScreening} from '../modules/organization/components/SavedOrganizationReport';
+export function SupabaseOrganizationRoadmap({reportId}:{reportId:string}){
+ const [report,setReport]=useState<SavedOrganizationScreening|null>(null),[error,setError]=useState('');
+ useEffect(()=>{
+  let active=true,generation=0;
+  async function load(){const request=++generation;setReport(null);setError('');try{const response=await pdmFetch(`/api/account-data?organization_report=${encodeURIComponent(reportId)}`);if(!active||request!==generation)return;if(response.status===401){window.location.replace(`/login?return_to=${encodeURIComponent(`/organization/roadmap/${reportId}`)}`);return;}const data=await response.json() as {screening?:SavedOrganizationScreening;error?:string};if(!response.ok||!data.screening)throw new Error(data.error||'This saved screening is unavailable.');if(active&&request===generation)setReport(data.screening);}catch(cause){if(active&&request===generation)setError(cause instanceof Error?cause.message:'This saved screening is unavailable.');}}
+  void load();
+  const {data}=getSupabaseBrowserClient().auth.onAuthStateChange(event=>{if(event==='SIGNED_OUT'||event==='SIGNED_IN'||event==='USER_UPDATED')void load();});
+  return()=>{active=false;generation++;data.subscription.unsubscribe();};
+ },[reportId]);
+ if(error)return <main className="results-wrap"><h1>Roadmap unavailable</h1><p role="alert">{error}</p><a href={`/organization?report=${encodeURIComponent(reportId)}`}>Back to the screening</a></main>;
+ if(!report)return <main className="results-wrap"><p role="status">Opening your screening’s visibility roadmap…</p></main>;
+ return <main><VisibilityRoadmap report={report} backHref={`/organization?report=${encodeURIComponent(report.id)}&view=full#screening`}/></main>;
+}
