+import {VisibilityRoadmap} from '../modules/organization/components/VisibilityRoadmap';
+import {BusinessVisibilityRoadmap} from './BusinessVisibilityRoadmap';
+type SharedPayload={type:'business';business:ReportBusiness;screening:ReportScreening}|{type:'organization';screening:SavedOrganizationScreening};
+export function SharedReport({token,roadmap=false}:{token:string;roadmap?:boolean}){
+ const [report,setReport]=useState<SharedPayload|null>(null),[error,setError]=useState('');
+ useEffect(()=>{let active=true;void fetch(`/api/shared-report?token=${encodeURIComponent(token)}`,{cache:'no-store',credentials:'omit'}).then(async response=>{const data=await response.json() as SharedPayload&{error?:string};if(!response.ok)throw new Error(data.error||'This share link is unavailable.');if(active)setReport(data);}).catch(cause=>{if(active)setError(cause instanceof Error?cause.message:'This report is unavailable.');});return()=>{active=false;};},[token]);
+ if(error)return <main className="results-wrap"><h1>Shared report unavailable</h1><p role="alert">{error}</p></main>;
+ if(!report)return <main className="results-wrap"><p role="status">Opening the completed report…</p></main>;
+ if(report.type==='business')return <div className="pdm-business-app"><BrandSectorProvider defaultSector="business">{roadmap?<BusinessVisibilityRoadmap business={report.business} screening={report.screening} backHref={`/shared/report/${token}`}/>:<ReportView business={report.business} screening={report.screening} shareToken={token}/>}</BrandSectorProvider></div>;
+ return <div className="pdm-organization-app"><BrandSectorProvider defaultSector={report.screening.organizationType==='nonprofit'?'nonprofit':report.screening.organizationType==='organization'?'organization':'ministry'}>{roadmap?<main><VisibilityRoadmap report={report.screening} backHref={`/shared/report/${token}`}/></main>:<ScreeningExperience shareToken={token}/>}</BrandSectorProvider></div>;
+}
