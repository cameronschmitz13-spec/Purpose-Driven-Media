+"use client";
+import {useState} from 'react';
+import {pdmFetch} from '../lib/pdm-fetch';
+export function ShareReportButton({reportId,publicPath}:{reportId?:string;publicPath?:string}){
+ const [path,setPath]=useState(publicPath||''),[busy,setBusy]=useState(false),[message,setMessage]=useState('');
+ async function share(){setBusy(true);setMessage('');try{
+ let urlPath=path;
+ if(!urlPath){const response=await pdmFetch('/api/report-share',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({reportId})});const data=await response.json() as {path?:string;error?:string};if(!response.ok||!data.path)throw new Error(data.error||'Could not share this report.');urlPath=data.path;setPath(urlPath);}
+ const url=new URL(urlPath,window.location.origin).href;
+ try{await navigator.clipboard.writeText(url);setMessage(publicPath?'Link copied. Opens this report directly.':'Link copied. Opens this report directly; read-only access expires in 30 days.');}catch{setMessage('Your direct report link is ready below.');}
+ }catch(cause){setMessage(cause instanceof Error?cause.message:'Could not share this report.');}finally{setBusy(false);}}
+ async function revoke(){setBusy(true);try{const response=await pdmFetch('/api/report-share',{method:'DELETE',headers:{'content-type':'application/json'},body:JSON.stringify({token:path.split('/').at(-1)})});const data=await response.json() as {revoked?:boolean};if(!response.ok||!data.revoked)throw new Error();setPath('');setMessage('This link has stopped sharing.');}catch{setMessage('Could not stop sharing. Please retry.');}finally{setBusy(false);}}
+ return <div className="share-report-control no-print"><button className="secondary-button" type="button" disabled={busy} onClick={()=>void share()}>{busy?'Please wait…':'Share report'}</button>{path&&<><input aria-label="Direct read-only report link" readOnly value={typeof window==='undefined'?path:new URL(path,window.location.origin).href} onFocus={event=>event.currentTarget.select()}/>{!publicPath&&<button type="button" disabled={busy} onClick={()=>void revoke()}>Stop sharing this link</button>}</>}<small role="status">{message}</small></div>;
+}
